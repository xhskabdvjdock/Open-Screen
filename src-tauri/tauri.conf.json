{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Screen",
  "version": "0.1.0",
  "identifier": "com.openscreen.app",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "url": "src/main.html",
        "title": "Open Screen",
        "width": 1,
        "height": 1,
        "visible": false,
        "skipTaskbar": true,
        "decorations": false
      },
      {
        "label": "overlay",
        "url": "src/overlay.html",
        "title": "Select area",
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      },
      {
        "label": "editor",
        "url": "src/editor.html",
        "title": "Open Screen — Editor",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520,
        "visible": false,
        "center": true
      },
      {
        "label": "settings",
        "url": "src/settings.html",
        "title": "Open Screen — Settings",
        "width": 860,
        "height": 640,
        "minWidth": 640,
        "minHeight": 480,
        "visible": false,
        "center": true
      },
      {
        "label": "history",
        "url": "src/history.html",
        "title": "Open Screen — History",
        "width": 900,
        "height": 620,
        "minWidth": 640,
        "minHeight": 480,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": ["**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "category": "Utility",
    "shortDescription": "Lightweight screenshot + editor + local OCR",
    "longDescription": "Open Screen: capture fast, edit when needed, OCR when needed. Local-first, lightweight.",
    "resources": [
      "resources/ffmpeg/ffmpeg.exe",
      "resources/tesseract/**/*"
    ]
  }
}
